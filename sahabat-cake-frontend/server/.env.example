# Konfigurasi Server
PORT=4000
NODE_ENV=development

# Konfigurasi Database MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/sahabatcake

# Konfigurasi JWT Admin
JWT_SECRET=rahasia_kunci_jwt_sahabat_cake_ganti_di_produksi
JWT_EXPIRES_IN=7d

# Kredensial Awal Admin (digunakan saat pertama kali seeding)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sahabatcake.com
ADMIN_PASSWORD=sahabat123

# URL Client Frontend
CLIENT_URL=http://localhost:5173
