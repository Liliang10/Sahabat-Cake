# Wajib di produksi (NODE_ENV=production). Jangan pakai kata sandi bawaan.
ADMIN_PASSWORD=ganti-dengan-kata-sandi-kuat

PORT=4001
# NODE_ENV=production

# Opsional
# TOKEN_SECRET=          # rahasia penanda tangan token; kosong = dibuat otomatis & disimpan di database
# TOKEN_TTL_HOURS=12     # lama sesi admin
# DB_FILE=./data/sahabat.sqlite
# UPLOAD_DIR=./uploads
# CORS_ORIGIN=https://domain-anda.com   # hanya bila frontend di domain lain
# TRUST_PROXY=1          # isi 1 jika di belakang Nginx/Cloudflare agar IP klien terbaca benar
